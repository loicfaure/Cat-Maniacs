{
  "name": "cat-dispenser",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first cat association management desktop application",
  "homepage": "https://github.com/",
  "author": "Cha'Mania",
  "license": "UNLICENSED",
  "desktopName": "ChaMania",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/run-electron.mjs",
    "demo": "npm run build && node scripts/run-demo.mjs",
    "demo:workflow": "npm run build && node scripts/replay-demo-workflow.mjs",
    "build": "node scripts/build.mjs",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "privacy": "node scripts/check-publication.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "check": "npm run privacy && npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "biome check src scripts tests",
    "lint:fix": "biome check --write --unsafe src scripts tests"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
